/* Write your global styles here, in PostCSS syntax */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Global theme styles */
:root {
  --primary-gradient: linear-gradient(135deg, #06b6d4, #3b82f6);
  --secondary-gradient: linear-gradient(135deg, #8b5cf6, #ec4899);
  --dark-gradient: linear-gradient(135deg, #1f2937, #111827);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  @apply bg-gray-900 text-white;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
}

/* Custom scrollbar for webkit browsers */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: rgba(31, 41, 55, 0.5);
}

::-webkit-scrollbar-thumb {
  background: rgba(96, 165, 250, 0.5);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(96, 165, 250, 0.7);
}

/* Firefox scrollbar */
* {
  scrollbar-width: thin;
  scrollbar-color: rgba(96, 165, 250, 0.5) rgba(31, 41, 55, 0.5);
}

/* Dark theme input styles */
.svelte-tags-input-layout {
	border-radius: 0.5rem !important;
	background-color: rgb(55 65 81) !important;
	border: 1px solid rgb(75 85 99) !important;
	color: rgb(243 244 246) !important;
}

.svelte-tags-input-layout:hover,
.svelte-tags-input-layout:focus,
.svelte-tags-input-layout:focus-within {
	border: 1px solid rgb(96 165 250) !important;
	outline: 1px solid rgb(96 165 250) !important;
	background-color: rgb(75 85 99) !important;
}

.svelte-tags-input-layout input {
	box-shadow: none !important;
	color: rgb(243 244 246) !important;
	background: transparent !important;
}

.svelte-tags-input-tag {
	color: rgb(243 244 246) !important;
	background-color: rgb(96 165 250) !important;
	border-radius: 0.375rem !important;
	border: 1px solid rgb(59 130 246) !important;
}

/* Dark theme custom scrollbar */
.custom-scrollbar::-webkit-scrollbar {
	width: 8px;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
	background-color: rgba(96, 165, 250, 0.5);
	border-radius: 4px;
	transition: background-color 0.2s ease;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
	background-color: rgba(96, 165, 250, 0.7);
}

.custom-scrollbar::-webkit-scrollbar-track {
	background-color: rgba(31, 41, 55, 0.5);
	border-radius: 4px;
}

/* Custom scrollbar for Firefox */
.custom-scrollbar {
	scrollbar-width: thin;
	scrollbar-color: rgba(96, 165, 250, 0.5) rgba(31, 41, 55, 0.5);
}

/* Modern card styles */
.card {
	background: rgba(31, 41, 55, 0.8);
	backdrop-filter: blur(12px);
	border: 1px solid rgba(75, 85, 99, 0.5);
	border-radius: 1rem;
	box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
	transition: all 0.3s ease;
}

.card:hover {
	transform: translateY(-2px);
	box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(96, 165, 250, 0.2);
}

/* Button styles */
.btn-primary {
	@apply bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700;
	@apply text-white font-medium px-6 py-3 rounded-lg;
	@apply transition-all duration-200 transform hover:scale-105;
	@apply focus:outline-none focus:ring-2 focus:ring-blue-500/50;
}

.btn-secondary {
	@apply bg-gray-700 hover:bg-gray-600 text-white font-medium px-6 py-3 rounded-lg;
	@apply transition-all duration-200 transform hover:scale-105;
	@apply focus:outline-none focus:ring-2 focus:ring-gray-500/50;
}

.btn-success {
	@apply bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700;
	@apply text-white font-medium px-6 py-3 rounded-lg;
	@apply transition-all duration-200 transform hover:scale-105;
	@apply focus:outline-none focus:ring-2 focus:ring-green-500/50;
}

.btn-danger {
	@apply bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700;
	@apply text-white font-medium px-6 py-3 rounded-lg;
	@apply transition-all duration-200 transform hover:scale-105;
	@apply focus:outline-none focus:ring-2 focus:ring-red-500/50;
}

/* Input styles */
.input-primary {
	@apply bg-gray-700 border border-gray-600 rounded-lg px-4 py-3;
	@apply text-white placeholder-gray-400;
	@apply focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20;
	@apply transition-all duration-200;
}

.input-primary:hover {
	@apply border-gray-500;
}

/* Textarea styles */
.textarea-primary {
	@apply bg-gray-700 border border-gray-600 rounded-lg px-4 py-3;
	@apply text-white placeholder-gray-400;
	@apply focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20;
	@apply transition-all duration-200 resize-none;
	font-family: 'Fira Code', 'Monaco', 'Consolas', 'Ubuntu Mono', monospace;
}

.textarea-primary:hover {
	@apply border-gray-500;
}

/* Select styles */
.select-primary {
	@apply bg-gray-700 border border-gray-600 rounded-lg px-4 py-3;
	@apply text-white;
	@apply focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20;
	@apply transition-all duration-200;
}

.select-primary:hover {
	@apply border-gray-500;
}

/* Gradient text utility */
.gradient-text {
	@apply text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500;
}

/* Glass effect utility */
.glass {
	background: rgba(31, 41, 55, 0.8);
	backdrop-filter: blur(12px);
	border: 1px solid rgba(75, 85, 99, 0.3);
}

/* Glow effect utility */
.glow {
	box-shadow: 0 0 20px rgba(96, 165, 250, 0.3);
}

.glow:hover {
	box-shadow: 0 0 30px rgba(96, 165, 250, 0.5);
}

/* Subtle focus effects */
.subtle-focus {
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.subtle-focus:focus {
  border-color: #6b7280;
  box-shadow: 0 0 0 2px rgba(107, 114, 128, 0.1);
}

@font-face {
	font-family: 'icomoon';
	src: url('/fonts/icomoon.eot?mpuld7');
	src:
		url('/fonts/icomoon.eot?mpuld7#iefix') format('embedded-opentype'),
		url('/fonts/icomoon.ttf?mpuld7') format('truetype'),
		url('/fonts/icomoon.woff?mpuld7') format('woff'),
		url('/fonts/icomoon.svg?mpuld7#icomoon') format('svg');
	font-weight: normal;
	font-style: normal;
	font-display: block;
}

[class^='icon-'],
[class*=' icon-'] {
	/* use !important to prevent issues with browser extensions that change fonts */
	font-family: 'icomoon' !important;
	speak: never;
	font-style: normal;
	font-weight: normal;
	font-variant: normal;
	text-transform: none;
	line-height: 1;

	/* Better Font Rendering =========== */
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
}

