@media (max-width: 780px) {
	.responsive-align-left h1 {
	  text-align: left;
	  margin-left: 0;
	}
	.responsive-align-left p {
	  text-align: left;
	  margin-left: 0;
	}
	
	/* Mobile optimizations */
	.btn-primary,
	.btn-secondary,
	.btn-success,
	.btn-danger {
		@apply px-4 py-2 text-sm;
	}
	
	.input-primary,
	.textarea-primary,
	.select-primary {
		@apply px-3 py-2 text-sm;
	}
	
	.card {
		@apply mx-2;
	}
}

/* Animation utilities */
@keyframes fadeInUp {
	from {
		opacity: 0;
		transform: translateY(30px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

@keyframes fadeInScale {
	from {
		opacity: 0;
		transform: scale(0.9);
	}
	to {
		opacity: 1;
		transform: scale(1);
	}
}

@keyframes pulse {
	0%, 100% {
		opacity: 1;
	}
	50% {
		opacity: 0.5;
	}
}

@keyframes shimmer {
	0% {
		background-position: -200% 0;
	}
	100% {
		background-position: 200% 0;
	}
}

.animate-fadeInUp {
	animation: fadeInUp 0.6s ease-out;
}

.animate-fadeInScale {
	animation: fadeInScale 0.4s ease-out;
}

.animate-shimmer {
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
	background-size: 200% 100%;
	animation: shimmer 2s infinite;
}

/* Loading skeleton */
.skeleton {
	@apply bg-gray-700 animate-pulse rounded;
}

/* Focus visible improvements */
.focus-visible:focus-visible {
	@apply outline-none ring-2 ring-blue-500/50 ring-offset-2 ring-offset-gray-900;
}

/* Text selection */
::selection {
	@apply bg-blue-500/30 text-white;
}

::-moz-selection {
	@apply bg-blue-500/30 text-white;
}

/* Code syntax highlighting overrides */
.hljs {
	@apply bg-gray-900 text-gray-100 !important;
	border-radius: 0.5rem;
}

/* Prism.js theme overrides */
code[class*="language-"],
pre[class*="language-"] {
	@apply text-gray-100 !important;
	background: rgb(17, 24, 39) !important;
}

.token.comment,
.token.prolog,
.token.doctype,
.token.cdata {
	@apply text-gray-500 !important;
}

.token.punctuation {
	@apply text-gray-300 !important;
}

.token.property,
.token.tag,
.token.boolean,
.token.number,
.token.constant,
.token.symbol,
.token.deleted {
	@apply text-red-400 !important;
}

.token.selector,
.token.attr-name,
.token.string,
.token.char,
.token.builtin,
.token.inserted {
	@apply text-green-400 !important;
}

.token.operator,
.token.entity,
.token.url,
.language-css .token.string,
.style .token.string {
	@apply text-yellow-400 !important;
}

.token.atrule,
.token.attr-value,
.token.keyword {
	@apply text-blue-400 !important;
}

.token.function,
.token.class-name {
	@apply text-purple-400 !important;
}

.token.regex,
.token.important,
.token.variable {
	@apply text-orange-400 !important;
}